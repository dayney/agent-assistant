{
  "name": "agent-assistant-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:demo": "VITE_CORE_MODE=demo npm run dev",
    "dev:real": "VITE_CORE_MODE=real npm run dev",
    "tauri:dev": "VITE_CORE_MODE=real tauri dev",
    "build": "tsc --noEmit && vite build",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "changelog": "git-cliff --config ../cliff.toml --prepend ../CHANGELOG.md",
    "changelog:preview": "git-cliff --config ../cliff.toml --unreleased"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "git-cliff": "^2.14.2",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
