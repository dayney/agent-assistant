{
  "name": "agent-assistant-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 1420",
    "dev:real": "npm run dev",
    "tauri:dev": "npm run build:core:bundle && tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:core": "node scripts/build-sidecar.mjs",
    "build:core:bundle": "node scripts/build-sidecar.mjs",
    "tauri:build": "npm run build:core:bundle && tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:sidecar",
    "test:sidecar": "node --test scripts/build-sidecar.node-test.mjs",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
